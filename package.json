{
  "name": "review-lsp",
  "version": "0.0.0",
  "private": true,
  "description": "Candidate-bound semantic code intelligence with provenance for AI code review",
  "type": "module",
  "bin": {
    "review-lsp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:acceptance": "vitest run --project acceptance",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "vscode-jsonrpc": "9.0.2",
    "vscode-languageserver-protocol": "3.18.3",
    "vscode-uri": "3.2.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "typescript-language-server": "6.0.0",
    "vitest": "4.1.0"
  },
  "license": "Apache-2.0"
}
